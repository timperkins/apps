rules_version = '2';

// Rules for the "slither" database. Every device signs in anonymously.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function room(code) {
      return get(/databases/$(database)/documents/rooms/$(code)).data;
    }

    function isHost(code) {
      return signedIn() && room(code).hostUid == request.auth.uid;
    }

    match /rooms/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
        && code.matches('^[BCDFGHJKLMNPQRSTVWXZ]{4}$')
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.phase == 'lobby'
        && request.resource.data.maxPlayers == 10;

      // Only the display writes the room, and it can never hand the room to someone else.
      allow update: if isHost(code)
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.phase in ['lobby', 'playing', 'over']
        && request.resource.data.maxPlayers == resource.data.maxPlayers;

      allow delete: if isHost(code);

      // A phone announces itself here; the display decides who gets a snake.
      match /players/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/rooms/$(code));
        allow delete: if signedIn() && (request.auth.uid == uid || isHost(code));
      }

      // WebRTC offer from the phone, answer from the display.
      match /rtc/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isHost(code));
        allow create: if signedIn()
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/rooms/$(code))
          && !('answer' in request.resource.data);
        allow update: if signedIn() && (
          (request.auth.uid == uid && !('answer' in request.resource.data))
          || (isHost(code) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer']))
        );
        allow delete: if signedIn() && (request.auth.uid == uid || isHost(code));
      }
    }
  }
}
