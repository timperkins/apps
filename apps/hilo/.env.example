# Local development against the Firebase emulators (npm run emulators). Copy to .env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-hilo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-hilo
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=hilo
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Either a real Gemini key, or HILO_FAKE_AI=1 for made-up answers.
# GEMINI_API_KEY=
HILO_FAKE_AI=1
