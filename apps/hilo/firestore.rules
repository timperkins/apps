rules_version = '2';

// HILO. The server (Firebase Admin, which bypasses these rules) makes every game change. Signed-in
// (anonymous) players can read games, and write one thing: a heartbeat on their own player document
// saying they're still here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{gameId} {
      allow read: if request.auth != null;

      match /players/{playerId} {
        allow read: if request.auth != null;
        allow update: if request.auth != null
          && request.auth.uid == playerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
          && request.resource.data.lastSeen == request.time;
      }

      match /rounds/{roundId} {
        allow read: if request.auth != null;
      }

      // Correct answers before they're revealed: server only.
      match /secrets/{roundId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
