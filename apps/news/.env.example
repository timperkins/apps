# Copy to .env.local for local development.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model and daily caps
GEMINI_MODEL=gemini-flash-latest
# Thinking level for story writing: minimal, low, medium, high or default
GEMINI_THINKING=low
DAILY_STORY_LIMIT=200
DAILY_FOLLOWUP_LIMIT=200

# Firebase web app config (Firebase console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firestore database ID (prod sets tim-news in apphosting.yaml; local and preview default to tim-news-preview)
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=tim-news-preview

# Server access to Firestore when running locally: paste a service account JSON on one line,
# or set GOOGLE_APPLICATION_CREDENTIALS to the file's path instead.
FIREBASE_SERVICE_ACCOUNT=
