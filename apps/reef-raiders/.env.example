# Optional overrides. The apps-97595 web config is built in (src/net/firebase.ts).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# Firestore database. CI sets it; local builds default to reef-raiders-preview.
# VITE_FIRESTORE_DATABASE_ID=reef-raiders-preview
# Set to "true" to use the local Firestore/Auth emulators (npm run emulators).
VITE_USE_EMULATORS=false
