rules_version = '2';

// Rules for the "my-hotel" databases. Every device signs in anonymously.
// A room only carries the WebRTC handshake for playing on two devices; the game itself goes
// over the direct link and is saved in the host's browser, never here.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isHost(code) {
      return signedIn() && get(/databases/$(database)/documents/rooms/$(code)).data.hostUid == request.auth.uid;
    }

    match /rooms/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
        && code.matches('^[BCDFGHJKLMNPQRSTVWXZ]{4}$')
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.maxPlayers == 2;

      allow update: if isHost(code) && request.resource.data.hostUid == resource.data.hostUid;
      allow delete: if isHost(code);

      // The joining device announces itself here.
      match /players/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/rooms/$(code));
        allow delete: if signedIn() && (request.auth.uid == uid || isHost(code));
      }

      // WebRTC offer from the joining device, answer from the host.
      match /rtc/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isHost(code));
        allow create: if signedIn()
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/rooms/$(code))
          && !('answer' in request.resource.data);
        allow update: if signedIn() && (
          (request.auth.uid == uid && !('answer' in request.resource.data))
          || (isHost(code) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer']))
        );
        allow delete: if signedIn() && (request.auth.uid == uid || isHost(code));
      }
    }
  }
}
